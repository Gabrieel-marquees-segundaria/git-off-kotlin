<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Cor quando o chip estiver selecionado -->
	<item android:color="#4D9FFF" android:state_checked="true" />

	<!-- Cor quando o chip estiver sendo pressionado -->
	<item android:color="#334D9FFF" android:state_pressed="true" />

	<!-- Cor padrão (não selecionado) -->
	<item android:color="#1A1D27" />
</selector>

