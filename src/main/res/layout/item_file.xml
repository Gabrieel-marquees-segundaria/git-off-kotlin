<?xml version="1.0" encoding="utf-8"?>
<!-- item_file.xml — Item da lista principal de arquivos -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1A1D27"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#2A2D3A"
    app:strokeWidth="1dp"
    app:rippleColor="#2A2D3A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <!-- Ícone do tipo de arquivo -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#0F1117"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivFileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_document"
                    android:contentDescription="Tipo de arquivo"

                    xmlns:tools="http://schemas.android.com/tools" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Informações do arquivo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="nome_do_arquivo.pdf"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="middle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,4 MB"
                    android:textColor="#7C7F9C"
                    android:textSize="12sp" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="#4A4D60"
                    />

                <TextView
                    android:id="@+id/tvFileDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoje, 14:32"
                    android:textColor="#7C7F9C"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botão de menu de contexto -->
        <ImageButton
            android:id="@+id/btnFileMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_more_vert_foreground"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mais opções"
            app:tint="#4A4D60" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>