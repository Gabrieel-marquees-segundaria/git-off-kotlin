<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Seção de Autenticação -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Autenticação GitHub"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnAuthGithub"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Auth GitHub"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_github"
                    android:drawablePadding="12dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:textAllCaps="false"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Não autenticado"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingLeft="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Seção de Token GitHub -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Título + ícone de informação -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Access Token"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>

                    <ImageButton
                        android:id="@+id/btnTokenInfo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_info_outline_foreground"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Informações sobre o token"
                        android:padding="4dp"
                        app:tint="#999999" />

                </LinearLayout>

                <!-- Tooltip de informação (visibilidade controlada por código) -->
                <LinearLayout
                    android:id="@+id/layoutTokenInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_tooltip"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/bg_info_tooltip"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription=""
                            app:tint="#1565C0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Para gerar um token: acesse GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic). Crie um token com a permissão &quot;repo&quot; marcada. Nunca compartilhe seu token com ninguém."
                            android:textSize="12sp"
                            android:textColor="#1565C0"
                            android:lineSpacingMultiplier="1.3"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTokenInfoLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abrir o GitHub →"
                        android:textSize="12sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:autoLink="web"
                        android:linksClickable="true"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cole seu token do GitHub (com permissão repo) para clonar repositórios privados"
                    android:textSize="12sp"

                    android:textColor="#999999"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAccessToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="ghp_xxxxxxxxxxxxxxxxx"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:padding="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnSaveToken"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Salvar Token"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_primary"
                    android:textAllCaps="false"/>

                <TextView
                    android:id="@+id/tvTokenStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Token não configurado"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:paddingTop="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Seção de Clonar Repositório -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clonar Repositório"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOwnerRepo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="dono/repositorio (ex: torvalds/linux)"
                        android:inputType="text"
                        android:textSize="14sp"
                        android:padding="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnClonar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Clonar com Token"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_primary"
                    android:textAllCaps="false"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvCloneResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>